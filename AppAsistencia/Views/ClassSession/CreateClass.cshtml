@using AppAsistencia.DTOs
@{
    ViewData["Title"] = "Registrar Clase";
    var cursos = ViewBag.Cursos as List<Classoptionsdto.SubjectOptionDTO> ?? new List<Classoptionsdto.SubjectOptionDTO>();
}

<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-8">
        <h1 class="text-3xl font-bold text-foreground mb-2">Registrar Clase</h1>
        <p class="text-muted-foreground">Programa una nueva sesión de clase</p>
    </div>

    @if (TempData["ErrorClase"] != null)
    {
        <div class="mb-6 p-3 rounded-lg bg-destructive/10 text-destructive text-sm text-center">
            @TempData["ErrorClase"]
        </div>
    }

    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-border">

        <form asp-controller="ClassSession" asp-action="CreateClass" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Curso -->
                <div>
                    <label for="SubjectId" class="block text-foreground mb-2 font-medium">Curso</label>
                    <select id="SubjectId"
                            name="SubjectId"
                            class="w-full px-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring font-medium"
                            required>
                        <option value="">Selecciona un curso</option>
                        @foreach (var curso in cursos)
                        {
                            <option value="@curso.IdSubject">@curso.SubjectCode - @curso.Name</option>
                        }
                    </select>
                </div>

                <!-- Grupo -->
                <div>
                    <label for="GroupName" class="block text-foreground mb-2 font-medium">Grupo</label>
                    <div class="relative">
                        <i class="bi bi-people absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="GroupName"
                               name="GroupName"
                               type="text"
                               placeholder="Ej: A01"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Fecha -->
                <div>
                    <label for="SessionDate" class="block text-foreground mb-2 font-medium">Fecha</label>
                    <div class="relative">
                        <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="SessionDate"
                               name="SessionDate"
                               type="date"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Aula -->
                <div>
                    <label for="Classroom" class="block text-foreground mb-2 font-medium">Aula</label>
                    <div class="relative">
                        <i class="bi bi-geo-alt absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="Classroom"
                               name="Classroom"
                               type="text"
                               placeholder="Ej: 301"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Hora de Inicio -->
                <div>
                    <label for="StartTime" class="block text-foreground mb-2 font-medium">Hora de Inicio</label>
                    <div class="relative">
                        <i class="bi bi-clock absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="StartTime"
                               name="StartTime"
                               type="time"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Hora de Fin -->
                <div>
                    <label for="EndTime" class="block text-foreground mb-2 font-medium">Hora de Fin</label>
                    <div class="relative">
                        <i class="bi bi-clock absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="EndTime"
                               name="EndTime"
                               type="time"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

            </div>

            <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <button type="submit"
                        class="flex-1 bg-primary text-primary-foreground py-3 rounded-lg hover:bg-secondary transition-colors flex items-center justify-center gap-2 font-medium shadow-md">
                    <i class="bi bi-arrow-right-circle text-lg"></i>
                    Continuar: Registrar Estudiantes
                </button>
                <a asp-controller="Home" asp-action="Index"
                   class="px-6 py-3 border border-border rounded-lg hover:bg-accent transition-colors text-center font-medium text-foreground block text-decoration-none">
                    Cancelar
                </a>
            </div>

        </form>
    </div>

    <!-- Caja informativa: ahora refleja que estos valores son globales (Parametrización), no por clase -->
    <div class="mt-8 bg-blue-50/80 rounded-xl p-6 border border-blue-200">
        <h3 class="font-bold text-foreground mb-3 text-base">
            <i class="bi bi-info-circle mr-1 text-primary"></i> Sobre la ventana de marcación
        </h3>
        <p class="text-sm text-muted-foreground">
            La ventana de marcación, el umbral de tardanza y los métodos de registro permitidos se
            configuran de forma global desde <b>Parametrización</b> (solo Administrador) y aplican
            automáticamente a todas las clases del sistema.
        </p>
    </div>

</div>
