@{
    ViewData["Title"] = "Registrar Clase";
}

<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Encabezado -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-foreground mb-2">Registrar Clase</h1>
        <p class="text-muted-foreground">Programa una nueva sesión de clase</p>
    </div>

    <!-- Tarjeta Principal con Formulario -->
    <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-border">
        
        <form asp-controller="Clases" asp-action="Registrar" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Curso -->
                <div>
                    <label for="curso" class="block text-foreground mb-2 font-medium">
                        Curso
                    </label>
                    <select id="curso"
                            name="curso"
                            class="w-full px-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring font-medium"
                            required>
                        <option value="">Selecciona un curso</option>
                        <option value="prog1">Programación I</option>
                        <option value="bd">Base de Datos</option>
                        <option value="algo">Algoritmos</option>
                        <option value="calculo">Cálculo</option>
                        <option value="fisica">Física</option>
                    </select>
                </div>

                <!-- Grupo -->
                <div>
                    <label for="grupo" class="block text-foreground mb-2 font-medium">
                        Grupo
                    </label>
                    <div class="relative">
                        <i class="bi bi-people absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="grupo"
                               name="grupo"
                               type="text"
                               placeholder="Ej: A01"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Fecha -->
                <div>
                    <label for="fecha" class="block text-foreground mb-2 font-medium">
                        Fecha
                    </label>
                    <div class="relative">
                        <i class="bi bi-calendar3 absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="fecha"
                               name="fecha"
                               type="date"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Aula -->
                <div>
                    <label for="aula" class="block text-foreground mb-2 font-medium">
                        Aula
                    </label>
                    <div class="relative">
                        <i class="bi bi-geo-alt absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="aula"
                               name="aula"
                               type="text"
                               placeholder="Ej: 301"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Hora de Inicio -->
                <div>
                    <label for="horaInicio" class="block text-foreground mb-2 font-medium">
                        Hora de Inicio
                    </label>
                    <div class="relative">
                        <i class="bi bi-clock absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="horaInicio"
                               name="horaInicio"
                               type="time"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Hora de Fin -->
                <div>
                    <label for="horaFin" class="block text-foreground mb-2 font-medium">
                        Hora de Fin
                    </label>
                    <div class="relative">
                        <i class="bi bi-clock absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="horaFin"
                               name="horaFin"
                               type="time"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- Umbral de Tardanza -->
                <div>
                    <label for="umbralTardanza" class="block text-foreground mb-2 font-medium">
                        Umbral de Tardanza (minutos)
                    </label>
                    <input id="umbralTardanza"
                           name="umbralTardanza"
                           type="number"
                           min="0"
                           max="30"
                           value="10"
                           class="w-full px-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring font-medium"
                           required />
                </div>

                <!-- Método de Registro Permitido -->
                <div>
                    <label for="metodoPermitido" class="block text-foreground mb-2 font-medium">
                        Método de Registro Permitido
                    </label>
                    <select id="metodoPermitido"
                            name="metodoPermitido"
                            class="w-full px-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring font-medium"
                            required>
                        <option value="todos">Todos (NFC, BLE, Biométrico)</option>
                        <option value="nfc">Solo NFC</option>
                        <option value="ble">Solo BLE</option>
                        <option value="biometrico">Solo Biométrico</option>
                        <option value="nfc-bio">NFC + Biométrico</option>
                    </select>
                </div>

            </div>

            <!-- Botones de Acción -->
            <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <button type="submit"
                        class="flex-1 bg-primary text-primary-foreground py-3 rounded-lg hover:bg-secondary transition-colors flex items-center justify-center gap-2 font-medium shadow-md">
                    <i class="bi bi-floppy text-lg"></i>
                    Guardar Clase
                </button>
                <a asp-controller="Home" asp-action="Index"
                   class="px-6 py-3 border border-border rounded-lg hover:bg-accent transition-colors text-center font-medium text-foreground block text-decoration-none">
                    Cancelar
                </a>
            </div>

        </form>
    </div>

    <!-- Caja Informativa Footer -->
    <div class="mt-8 bg-blue-50/80 rounded-xl p-6 border border-blue-200">
        <h3 class="font-bold text-foreground mb-3 text-base">
            <i class="bi bi-gear mr-1 text-primary"></i> Configuración de Registro
        </h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
            <li class="flex items-center gap-2">
                <span class="text-primary">•</span>
                Los estudiantes pueden marcar asistencia 10 minutos antes del inicio
            </li>
            <li class="flex items-center gap-2">
                <span class="text-primary">•</span>
                La ventana de registro se cierra 15 minutos después del inicio
            </li>
            <li class="flex items-center gap-2">
                <span class="text-primary">•</span>
                El umbral de tardanza determina cuándo se marca como "Tardanza" en lugar de "Presente"
            </li>
            <li class="flex items-center gap-2">
                <span class="text-primary">•</span>
                Puedes configurar qué métodos de registro están permitidos para esta clase
            </li>
        </ul>
    </div>

</div>