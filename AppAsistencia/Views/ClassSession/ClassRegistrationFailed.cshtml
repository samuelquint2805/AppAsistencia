@{
    ViewData["Title"] = "Clase No Registrada";
}

<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-blue-50 to-white">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-xl p-12 border border-border text-center">
            <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="bi bi-x-circle text-destructive" style="font-size: 3rem;"></i>
            </div>
            <h1 class="text-foreground mb-4">Clase No Registrada</h1>
            <p class="text-muted-foreground mb-8">@ViewBag.Error</p>

            <div class="flex flex-col gap-3">
                <a asp-controller="ClassSession" asp-action="CreateClass"
                   class="w-full bg-primary text-primary-foreground py-3 rounded-lg hover:bg-secondary transition-colors font-medium block text-decoration-none">
                    Intentar de nuevo
                </a>
                <a asp-controller="Home" asp-action="Index"
                   class="w-full border border-border py-3 rounded-lg hover:bg-accent transition-colors font-medium text-foreground block text-decoration-none">
                    Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>
