@using AppAsistencia.DTOs
@model List<GroupSummaryDTO>
@{
    ViewData["Title"] = "Clases Registradas";
}

<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-8 flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-3xl font-bold text-foreground mb-2">Clases Registradas</h1>
            <p class="text-muted-foreground">Administra las clases que has creado</p>
        </div>
        <a asp-controller="ClassSession" asp-action="CreateClass"
           class="bg-primary text-primary-foreground px-5 py-3 rounded-lg hover:bg-secondary transition-colors font-medium flex items-center gap-2 text-decoration-none">
            <i class="bi bi-plus-circle"></i> Registrar nueva clase
        </a>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="mb-6 p-3 rounded-lg bg-green-100 text-green-800 text-sm text-center">@ViewBag.Mensaje</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="mb-6 p-3 rounded-lg bg-destructive/10 text-destructive text-sm text-center">@ViewBag.Error</div>
    }

    @if (!Model.Any())
    {
        <div class="bg-white rounded-xl shadow-md border border-border p-12 text-center">
            <i class="bi bi-calendar-x text-5xl text-muted-foreground opacity-50 block mb-4"></i>
            <h3 class="text-xl font-bold text-foreground mb-2">Aún no tienes clases registradas</h3>
            <p class="text-muted-foreground">Registra tu primera clase para empezar a tomar asistencia.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var clase in Model)
            {
                <div class="bg-white rounded-xl shadow-md border-2 @(clase.IsActive ? "border-border" : "border-border/50 opacity-70") p-6">
                    <div class="flex items-start justify-between flex-wrap gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-3 mb-2 flex-wrap">
                                <h2 class="text-lg font-bold text-foreground">@clase.SubjectName</h2>
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-primary">Grupo @clase.GroupName</span>
                                @if (!clase.IsActive)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-200 text-gray-600">Desactivada</span>
                                }
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 text-sm mt-3">
                                <div class="flex items-center gap-2">
                                    <i class="bi bi-geo-alt text-muted-foreground"></i>
                                    <span class="text-foreground">Aula @clase.Classroom</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <i class="bi bi-clock text-muted-foreground"></i>
                                    <span class="text-foreground">@clase.Schedule</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <i class="bi bi-people text-muted-foreground"></i>
                                    <span class="text-foreground">@clase.TotalEstudiantes estudiantes</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <i class="bi bi-calendar-check text-muted-foreground"></i>
                                    <span class="text-foreground">
                                        @(clase.ProximaSesion.HasValue ? clase.ProximaSesion.Value.ToString("dd/MM/yyyy HH:mm") : "Sin próxima sesión")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-2 flex-shrink-0">
                            <a asp-controller="ClassSession" asp-action="RegisterStudents" asp-route-idGroup="@clase.IdGroup"
                               class="p-2.5 rounded-lg border border-border hover:bg-blue-50 text-muted-foreground hover:text-primary transition-colors" title="Agregar estudiantes">
                                <i class="bi bi-person-plus text-lg"></i>
                            </a>
                            <a asp-controller="ClassSession" asp-action="EditClass" asp-route-id="@clase.IdGroup"
                               class="p-2.5 rounded-lg border border-border hover:bg-blue-50 text-muted-foreground hover:text-primary transition-colors" title="Editar">
                                <i class="bi bi-pencil text-lg"></i>
                            </a>
                            @if (clase.IsActive)
                            {
                                <form asp-controller="ClassSession" asp-action="DeactivateClass" asp-route-id="@clase.IdGroup" method="post"
                                      onsubmit="return confirm('¿Desactivar esta clase? No se eliminará el historial de asistencia.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-2.5 rounded-lg border border-border hover:bg-red-50 text-muted-foreground hover:text-destructive transition-colors" title="Desactivar">
                                        <i class="bi bi-trash text-lg"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
