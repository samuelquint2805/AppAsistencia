@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="w-full min-h-[calc(100vh-5rem)] flex items-center justify-center px-4 py-8 bg-gradient-to-br from-blue-50 to-white">
    <div class="w-full max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-border">

            <!-- Encabezado -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-foreground mb-2">Crear Cuenta</h1>
                <p class="text-muted-foreground">Regístrate en el Sistema de Control de Asistencia ITM</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="mb-6 p-3 rounded-lg bg-destructive/10 text-destructive text-sm text-center">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="RegisterStudent" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

               

                <!-- CAMPOS COMUNES: Nombre Completo  -->
          <div class="mb-6">
    <label for="name" class="block text-foreground mb-2 font-medium">
        Nombre Completo
    </label>
    <div class="relative">
        <i class="bi bi-person absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
        <input id="name"
               name="name"
               type="text"
               placeholder="Ej: Juan Pérez"
               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
               required />
    </div>
</div>

                <!-- CAMPO COMÚN: Correo Institucional -->
                <div>
                    <label for="email" class="block text-foreground mb-2 font-medium">
                        Correo Institucional
                    </label>
                    <div class="relative">
                        <i class="bi bi-envelope absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="email"
                               name="email"
                               type="email"
                               placeholder="usuario@itm.edu.co"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <!-- SECCIÓN DINÁMICA: CAMPOS PARA ESTUDIANTE -->
                <div id="studentFields" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label for="studentIdCard" class="block text-foreground mb-2 font-medium">
                                Carnet Estudiantil
                            </label>
                            <div class="relative">
                                <i class="bi bi-person-badge absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                                <input id="studentIdCard"
                                       name="studentIdCard"
                                       type="text"
                                       placeholder="Carnet EST"
                                       class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring" />
                            </div>
                        </div>

                        <div>
                            <label for="phoneNumber" class="block text-foreground mb-2 font-medium">
                                Teléfono
                            </label>
                            <div class="relative">
                                <i class="bi bi-telephone absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                                <input id="phoneNumber"
                                       name="phoneNumber"
                                       type="tel"
                                       placeholder="3001234567"
                                       class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring" />
                            </div>
                        </div>

                        <div>
                            <label for="currentSemester" class="block text-foreground mb-2 font-medium">
                                Semestre Cursado
                            </label>
                            <select id="currentSemester"
                                    name="currentSemester"
                                    class="w-full px-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring">
                                <option value="">Seleccionar...</option>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <option value="@i">Semestre @i</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

               

                <!-- CAMPOS COMUNES: Contraseñas -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="password" class="block text-foreground mb-2 font-medium">
                            Contraseña
                        </label>
                        <div class="relative">
                            <i class="bi bi-lock absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                            <input id="password"
                                   name="password"
                                   type="password"
                                   class="w-full pl-12 pr-12 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                                   required />
                            <button type="button"
                                    onclick="togglePassword('password', 'eyeIcon1')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                                <i id="eyeIcon1" class="bi bi-eye text-xl"></i>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label for="confirmPassword" class="block text-foreground mb-2 font-medium">
                            Confirmar Contraseña
                        </label>
                        <div class="relative">
                            <i class="bi bi-lock absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                            <input id="confirmPassword"
                                   name="confirmPassword"
                                   type="password"
                                    pattern="^(?=.*[A-Za-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{6,}$"
       title="Mínimo 6 caracteres, incluye letras, números y un carácter especial"
                                   class="w-full pl-12 pr-12 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                                   required />
                            <button type="button"
                                    onclick="togglePassword('confirmPassword', 'eyeIcon2')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                                <i id="eyeIcon2" class="bi bi-eye text-xl"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Términos -->
                <div class="flex items-center gap-2">
                    <input id="terms"
                           type="checkbox"
                           class="w-4 h-4 rounded border-input text-primary focus:ring-2 focus:ring-ring"
                           required />
                    <label for="terms" class="text-sm text-muted-foreground">
                        Acepto los términos y condiciones y la política de privacidad
                    </label>
                </div>

                <!-- Botón Enviar -->
                <button type="submit"
                        class="w-full bg-primary text-primary-foreground py-3 rounded-lg hover:bg-secondary transition-colors font-medium">
                    Crear Cuenta
                </button>

                <!-- Link a Login -->
                <div class="text-center text-sm text-muted-foreground">
                    ¿Ya tienes cuenta?
                    <a asp-controller="Account" asp-action="LoginEstudiante" class="text-primary hover:underline font-medium ml-1">
                        Inicia sesión aquí
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleUserFields() {
            const userType = document.getElementById('userType').value;
           
        }

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
