@{
    ViewData["Title"] = "Inicio de Sesión Exitoso";
}

<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-blue-50 to-white">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-xl p-12 border border-border text-center">
            <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6 animate-bounce">
                <i class="bi bi-check-circle text-green-600" style="font-size: 3rem;"></i>
            </div>
            <h1 class="text-foreground mb-4">¡Inicio de Sesión Exitoso!</h1>
            <p class="text-muted-foreground mb-6">Verificación completada correctamente</p>
            <div class="flex items-center justify-center gap-2">
                <div class="w-2 h-2 bg-primary rounded-full animate-pulse"></div>
                <p class="text-sm text-muted-foreground">Redirigiendo al inicio...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Equivalente al useEffect + setTimeout del componente original
        setTimeout(function () {
            window.location.href = '/Home/Index';
        }, 2000);
    </script>
}
