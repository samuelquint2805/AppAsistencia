@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
    bool enviado = ViewBag.Enviado ?? false; // Permite manejar la confirmación también desde C#
}

<div class="w-full min-h-[calc(100vh-5rem)] flex items-center justify-center px-4 py-8 bg-gradient-to-br from-blue-50 to-white">
    <div class="w-full max-w-md mx-auto">
        
        <!-- ESTADO 1: Formulario de Recuperación -->
        <div id="formState" class="bg-white rounded-2xl shadow-xl p-8 border border-border @(enviado ? "hidden" : "")">
            
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-envelope text-primary text-3xl"></i>
                </div>
                <h1 class="text-2xl font-bold text-foreground mb-2">¿Olvidaste tu contraseña?</h1>
                <p class="text-sm text-muted-foreground leading-relaxed">
                    Ingresa tu correo institucional y te enviaremos instrucciones para recuperarla
                </p>
            </div>

            <form id="forgotPasswordForm" asp-controller="Account" asp-action="ForgotPassword" method="post" onsubmit="handleSubmit(event)" class="space-y-6">
                @Html.AntiForgeryToken()

                <div>
                    <label for="email" class="block text-foreground mb-2 font-medium">
                        Correo Institucional
                    </label>
                    <div class="relative">
                        <i class="bi bi-envelope absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted-foreground"></i>
                        <input id="email"
                               name="email"
                               type="email"
                               placeholder="estudiante@itm.edu.co"
                               class="w-full pl-12 pr-4 py-3 bg-input-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-ring"
                               required />
                    </div>
                </div>

                <button type="submit"
                        class="w-full bg-primary text-primary-foreground py-3 rounded-lg hover:bg-secondary transition-colors font-medium shadow-md">
                    Enviar Instrucciones
                </button>

                <div class="text-center">
                    <a asp-controller="Account" asp-action="LoginSelection"
                       class="inline-flex items-center justify-center gap-2 text-primary hover:underline font-medium text-sm text-decoration-none">
                        <i class="bi bi-arrow-left"></i>
                        Volver al inicio de sesión
                    </a>
                </div>
            </form>
        </div>

        <!-- ESTADO 2: Confirmación de Correo Enviado -->
        <div id="successState" class="bg-white rounded-2xl shadow-xl p-8 border border-border text-center @(enviado ? "" : "hidden")">
            
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="bi bi-check-circle text-green-600 text-4xl"></i>
            </div>
            
            <h2 class="text-2xl font-bold text-foreground mb-4">¡Correo Enviado!</h2>
            <p class="text-muted-foreground mb-6 leading-relaxed">
                Hemos enviado las instrucciones para restablecer tu contraseña a<br />
                <span id="targetEmail" class="text-primary font-semibold">@ViewBag.EmailEnviado</span>
            </p>
            
            <p class="text-xs text-muted-foreground mb-6">
                Si no recibes el correo en los próximos minutos, revisa tu carpeta de spam.
            </p>

            <a asp-controller="Account" asp-action="LoginSelection"
               class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-3 rounded-lg hover:bg-secondary transition-colors font-medium shadow-md text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                Volver al inicio de sesión
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function handleSubmit(e) {
            // Nota: Si deseas hacer la prueba en el frontend en vivo sin recargar:
            // e.preventDefault(); 

            const emailInput = document.getElementById('email').value;
            document.getElementById('targetEmail').innerText = emailInput;

            document.getElementById('formState').classList.add('hidden');
            document.getElementById('successState').classList.remove('hidden');
        }
    </script>
}