@{
    ViewData["Title"] = "Acceso Denegado";

    // Determina el destino de redirección según el estado de autenticación
    var estaAutenticado = User.Identity?.IsAuthenticated ?? false;
    var urlRedireccion = estaAutenticado ? "/Home/Index" : "/Account/LoginSelection";
    var mensajeRedireccion = estaAutenticado
        ? "Redirigiendo a tu panel de inicio..."
        : "Redirigiendo a selección de acceso...";
    var mensajeDescripcion = estaAutenticado
        ? "No tienes permisos para acceder a esta sección. Contacta al administrador si crees que es un error."
        : "Debes iniciar sesión para acceder a esta sección.";
}

<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-blue-50 to-white">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-xl p-12 border border-border text-center">

            <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="bi bi-shield-exclamation text-destructive" style="font-size: 3rem;"></i>
            </div>

            <h1 class="text-foreground mb-4">Acceso Denegado</h1>

            <p class="text-muted-foreground mb-6">
                @mensajeDescripcion
            </p>

            <div class="flex items-center justify-center gap-2 mb-6">
                <div class="w-2 h-2 bg-destructive rounded-full animate-pulse"></div>
                <p class="text-sm text-muted-foreground">@mensajeRedireccion</p>
            </div>

            
          

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // La variable de destino se inyecta desde Razor (C#) de forma segura
        const urlDestino = '@urlRedireccion';

        setTimeout(function () {
            window.location.href = urlDestino;
        }, 4000);
    </script>
}